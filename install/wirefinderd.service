# wirefinderd — the privileged WireGuard daemon, as a managed systemd service.
# Install:  sudo install -Dm644 wirefinderd.service /etc/systemd/system/wirefinderd.service

[Unit]
Description=wirefinder WireGuard daemon
Documentation=https://man7.org/linux/man-pages/man5/systemd.service.5.html
# The tunnel interface needs the network up first.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No config-file argument: the daemon starts with whatever it has persisted
# (nothing, on a fresh install) and is configured entirely over IPC by the GUI.
ExecStart=/usr/bin/wirefinderd

# Persisted state (the interface private key + servers) lives here. systemd creates
# /var/lib/wirefinder as root:wirefinder before the daemon starts; the daemon writes
# state.json mode 0600, so the private key stays root-only. 0750 keeps even the
# directory listing away from everyone outside the wirefinder group. This matches
# config::DEFAULT_STATE_PATH in the daemon.
StateDirectory=wirefinder
StateDirectoryMode=0750

# The control socket lives in /run/wirefinder (see proto::SOCKET_PATH). systemd
# provisions this as root:wirefinder before start; 0750 means only the wirefinder
# group can traverse into it, so the socket is never exposed to other users even
# for the instant before the daemon sets its mode.
RuntimeDirectory=wirefinder
RuntimeDirectoryMode=0750

# euid stays root (creating a WireGuard interface needs CAP_NET_ADMIN), but the
# process's *group* is `wirefinder`. The Unix socket the daemon bind()s inherits
# the creating process's egid, so it lands as root:wirefinder with mode 0660 —
# any user in the `wirefinder` group (your desktop login) can talk to it. systemd
# is NOT sudo: there's no SUDO_UID here, so the dev-time chown is skipped and the
# group is how we hand access to the unprivileged UI.
Group=wirefinder

# Stop = SIGTERM, and stopping is CONTROL-PLANE ONLY: WireGuard runs in-kernel,
# so the daemon's signal handler exits without touching the tunnel — a stop or a
# package-upgrade restart must never drop the user's VPN (or its kill-switch
# routing). The tunnel comes down only via an explicit Disconnect, or on package
# removal (install/prerm). SIGTERM is systemd's default KillSignal; stated here
# for intent. TimeoutStopSec bounds the handler before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=10s

# Restart on a crash, but not on a clean stop (the signal handler exits 0). A
# restarted daemon reattaches to the live interface by reading its state.
Restart=on-failure
RestartSec=2s

# ── Sandboxing ────────────────────────────────────────────────────────────────
# As tight as the daemon's real needs allow. What it actually does: netlink to
# configure the interface (AF_NETLINK), the control socket (AF_UNIX), endpoint
# hostname lookups (AF_INET/AF_INET6), and a resolvconf shell-out that — depending
# on the distro — rewrites /etc/resolv.conf, /run/resolvconf, or talks to
# systemd-resolved over the D-Bus socket in /run. That resolver variability is why
# ProtectSystem stays at "true" (/usr and /boot read-only) rather than "strict":
# /etc and /run must remain writable for DNS changes to apply.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=true
ProtectHome=yes
PrivateTmp=yes
# ProtectKernelTunables is deliberately ABSENT: every full-tunnel switch writes
# net.ipv4.conf.all.src_valid_mark=1 to /proc/sys (defguard's routing setup, the
# same sysctl wg-quick sets), and a read-only /proc/sys fails the switch with
# EROFS. The write is unconditional in defguard, so it can't be pre-set once.
# Blocks module-loading SYSCALLS from the daemon. First-use autoload of the
# wireguard module still works — the kernel loads it itself on interface creation.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# @system-service is systemd's curated allow-list (includes exec, needed for the
# resolvconf shell-out). Denied syscalls fail with EPERM instead of killing the
# daemon with SIGSYS, so a probing library degrades instead of crashing it.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
